# Super Signal Environment Variables
# Copy to .env and fill in your values. Never commit .env

# Application
APP_ENV=development # development | testnet | production
APP_SECRET_KEY=change-me-to-a-strong-random-secret-at-least-32-chars
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/supersignal.db
# Production example: postgresql+psycopg://user:password@pghost:5432/dbname?sslmode=require

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_RECV_WINDOW=5000

# ThreeRouter AI
THREEROUTER_API_KEY=
THREEROUTER_BASE_URL=https://api.threerouter.com
THREEROUTER_TIMEOUT_SECONDS=15
THREEROUTER_MAX_CONCURRENCY=5

# Security
# Generate unique values locally; never commit them.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CREDENTIALS_ENCRYPTION_KEY= # base64 Fernet key, generated via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY_VERSION=1

# Engine defaults
TRIGGER_PERCENTAGE=1.5
TRIGGER_WINDOW_SECONDS=180
BASE_MARGIN=3
LEVERAGE=10
MAX_CONCURRENT_TRADES=3
PROFIT_REINVESTMENT_PCT=25
MAX_TRADE_ALLOCATION=100
DAILY_LOSS_LIMIT=50
MAX_DRAWDOWN_PCT=10
MAX_AGGREGATE_EXPOSURE=1000
MAX_CONSECUTIVE_LOSSES=5
MAX_SLIPPAGE_BPS=50
TAKER_FEE_BPS=4
CANDIDATE_TTL_SECONDS=30
COOLDOWN_SECONDS=300
PROTECTION_DEADLINE_SECONDS=10

# Browser origins allowed for HTTP and WebSocket. Add exact trusted origins only.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
